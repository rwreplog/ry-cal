POSTGRES_DB=replogle_hq
POSTGRES_USER=replogle_hq
POSTGRES_PASSWORD=change-me
# Host-exposed port for the postgres container. Defaults to 5433 (not 5432) to
# avoid clashing with a native/other-project Postgres already on 5432.
POSTGRES_PORT=5433

ASPNETCORE_ENVIRONMENT=Development

VITE_API_BASE_URL=http://localhost:8080

AUTH_SECRET=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

WEATHER_API_KEY=
